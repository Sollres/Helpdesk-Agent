# Copier ce fichier en .env (ne jamais committer .env)

# Fournisseur LLM : ollama (local, gratuit) ou openai
AI_PROVIDER=ollama

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=bge-m3

# OpenAI (uniquement si AI_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# Base de données
DB_URL=jdbc:postgresql://localhost:5432/helpdesk
DB_USER=helpdesk
DB_PASSWORD=helpdesk
# 1024 pour bge-m3, 1536 pour text-embedding-3-small (OpenAI)
EMBEDDING_DIMENSIONS=1024
